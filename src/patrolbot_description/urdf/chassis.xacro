<?xml version="1.0"?>
<!--
  Chassis: base_footprint -> base_link, four wheels driven as a
  two-motor differential drive (same-side wheels share one virtual motor,
  see doc/0.req/1.patrol-robot-sim.md ch3).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="patrolbot_chassis">

    <!-- ground-projected root frame, consumed by Nav2 / robot_localization -->
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
    </joint>

    <!-- chassis box: 0.42 x 0.32 x 0.08, 0.04 m ground clearance -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
      </collision>
      <xacro:inertial_box mass="${mass_base}"
                          x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"
                          xyz="0 0 0"/>
    </link>

    <gazebo reference="base_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <!-- ===================== wheels ===================== -->
    <xacro:macro name="patrolbot_wheel" params="name x y">
      <link name="${name}_wheel_link">
        <!-- tyre: cylinder rotated so its axis is along y -->
        <visual>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
          <material name="rubber"/>
        </visual>
        <!-- hub -->
        <visual>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius * 0.45}" length="${wheel_width + 0.004}"/>
          </geometry>
          <material name="aluminium"/>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="${mass_wheel}"/>
          <inertia ixx="${mass_wheel * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"
                   ixy="0" ixz="0"
                   iyy="${mass_wheel * wheel_radius * wheel_radius / 2.0}"
                   iyz="0"
                   izz="${mass_wheel * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12.0}"/>
        </inertial>
      </link>

      <joint name="${name}_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${name}_wheel_link"/>
        <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="20.0" velocity="40.0"/>
        <dynamics damping="0.05" friction="0.0"/>
      </joint>

      <gazebo reference="${name}_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.0</maxVel>
      </gazebo>
    </xacro:macro>

    <xacro:patrolbot_wheel name="front_left"
                           x="${wheelbase/2.0}" y="${wheel_separation/2.0}"/>
    <xacro:patrolbot_wheel name="rear_left"
                           x="${-wheelbase/2.0}" y="${wheel_separation/2.0}"/>
    <xacro:patrolbot_wheel name="front_right"
                           x="${wheelbase/2.0}" y="${-wheel_separation/2.0}"/>
    <xacro:patrolbot_wheel name="rear_right"
                           x="${-wheelbase/2.0}" y="${-wheel_separation/2.0}"/>

  </xacro:macro>

</robot>
